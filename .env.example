# ==========================================================================
# Lead Finder — frontend configuration
#
#     cp .env.example .env.local
#
# Placeholders only. `.env.local` is gitignored; this file is committed, so
# nothing secret belongs here.
#
# Note that anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript
# bundle at build time and is therefore visible to anyone who loads the page.
# It is for configuration, never for secrets.
# ==========================================================================

# Base URL of the FastAPI backend. No trailing slash (one is stripped anyway).
#
# Because it is inlined at build time, a Docker image baked with one value
# cannot be pointed at a different API at run time — rebuild, or serve the
# frontend behind a proxy that fronts both on one origin.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side only credential used by Playwright. Set it in the shell running
# Playwright; never expose it through a NEXT_PUBLIC_ variable or commit a value.
PLAYWRIGHT_ADMIN_SECRET=

# Server-side contract verifier only. Set in the invoking process; never commit a value.
VERIFY_API_ADMIN_SECRET=
